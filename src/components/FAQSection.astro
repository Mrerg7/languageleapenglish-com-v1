---
import { FAQS } from '../data/faq';
import { ACQUISITION_MAILTO } from '../config/site';
import Icon from './Icon.astro';
---

<section id="faq" class="bg-slate-900 border-y border-slate-800 py-16">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-10" data-reveal>
      <div class="uppercase tracking-[3px] text-xs font-semibold text-amber-500 mb-2">DOMAIN ACQUISITION FAQ</div>
      <h2 class="section-header tracking-tighter">
        Everything buyers ask before<br />acquiring languageleapenglish.com
      </h2>
    </div>

    <div class="space-y-3">
      {FAQS.map((faq, index) => (
        <details
          class="group bg-slate-950 border border-slate-800 rounded-2xl overflow-hidden open:border-amber-500/40 transition-colors"
          data-reveal
          open={index === 0}
        >
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none min-h-12 px-5 sm:px-6 py-4 text-[15px] sm:text-base font-semibold text-slate-100 hover:text-amber-300 transition-colors">
            <span class="flex items-start gap-x-3">
              <span class="text-amber-500/70 font-mono text-xs mt-1.5">{String(index + 1).padStart(2, '0')}</span>
              <span>{faq.question}</span>
            </span>
            <span class="text-slate-400 group-open:text-amber-400 transition-transform group-open:rotate-180 shrink-0 mt-0.5">
              <Icon name="chevron-down" class="text-xl" />
            </span>
          </summary>
          <div class="px-5 sm:px-6 pb-5 text-slate-400 text-[15px] leading-relaxed pl-11 sm:pl-14">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>

    <p class="text-center text-sm text-slate-400 mt-8" data-reveal>
      Still have a question?
      <a
        href={ACQUISITION_MAILTO}
        data-open-contact
        data-cta="faq-contact"
        class="text-amber-400 underline underline-offset-4 hover:text-amber-300"
      >
        Ask the owner directly
      </a>
      — replies within 24 hours.
    </p>
  </div>
</section>
