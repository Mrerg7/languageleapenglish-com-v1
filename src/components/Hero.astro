---
import { PRICE } from '../config/site';
import Icon from './Icon.astro';

const heroBg = '/hero.webp';
---

<header
  class="hero-bg min-h-[100dvh] flex items-center relative pt-20 md:pt-0"
  style={`background-image: linear-gradient(rgba(15, 23, 42, 0.65), rgba(15, 23, 42, 0.75)), url('${heroBg}');`}
>
  <div class="max-w-screen-xl mx-auto px-6 pb-28 md:pb-0 w-full">
    <div class="max-w-4xl">
      <div
        class="inline-flex items-center gap-x-2 bg-white/10 backdrop-blur-md border border-white/20 text-white text-xs font-semibold tracking-[1.5px] px-4 py-2 rounded-3xl mb-6"
      >
        <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse" aria-hidden="true"></span>
        <span>PREMIUM .COM DOMAIN • AVAILABLE NOW</span>
      </div>

      <h1 class="domain-hero text-white tracking-tighter mb-4">
        languageleap<span class="text-amber-400">english</span>.com
      </h1>

      <p class="max-w-2xl text-xl sm:text-2xl md:text-3xl font-light tracking-tight text-slate-200 mb-8">
        Own the definitive brand for <span class="font-medium text-white">English language mastery</span> in a
        globalized world.
      </p>

      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-8">
        <button
          type="button"
          data-open-purchase
          data-cta="hero-buy-now"
          class="group w-full sm:w-auto inline-flex min-h-12 items-center justify-center gap-x-3 bg-white hover:bg-amber-50 active:bg-white text-slate-950 font-semibold text-base sm:text-lg px-6 sm:px-10 py-4 rounded-3xl transition-all shadow-2xl active:scale-[0.985]"
        >
          <span>Secure This Domain — {PRICE.formatted}</span>
          <Icon name="arrow-right" class="transition group-active:translate-x-1" />
        </button>

        <a
          href="#stats"
          data-cta="hero-see-data"
          class="w-full sm:w-auto inline-flex min-h-12 items-center justify-center gap-x-2 px-6 sm:px-8 py-4 text-base sm:text-lg font-medium border border-white/30 hover:bg-white/10 rounded-3xl transition-all"
        >
          <span>See the data</span>
        </a>

        <button
          type="button"
          data-open-contact
          data-cta="hero-make-offer"
          class="w-full sm:w-auto inline-flex min-h-12 items-center justify-center gap-x-2 px-6 sm:px-8 py-4 text-base sm:text-lg font-medium text-slate-300 hover:text-white underline decoration-white/30 underline-offset-8 hover:decoration-white/70 transition-all"
        >
          <span>Make an offer</span>
        </button>
      </div>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm text-slate-300">
        <li class="flex items-center gap-x-2">
          <span class="text-emerald-400"><Icon name="shield" class="text-base" /></span>
          Escrow.com protected transfer
        </li>
        <li class="flex items-center gap-x-2">
          <span class="text-emerald-400"><Icon name="clock" class="text-base" /></span>
          Typical transfer time: 24 hours
        </li>
        <li class="flex items-center gap-x-2">
          <span class="text-emerald-400"><Icon name="key" class="text-base" /></span>
          One owner, one .com — this one
        </li>
      </ul>
    </div>
  </div>

  <div class="absolute bottom-8 left-1/2 hidden md:block">
    <a
      href="#stats"
      class="flex flex-col items-center cursor-pointer group"
      aria-label="Scroll to market data"
    >
      <span class="text-[10px] tracking-[2px] text-white/60 mb-1.5 group-hover:text-white/90 transition">SCROLL TO EXPLORE</span>
      <Icon name="chevron-down" class="text-white/60 group-hover:text-white/90 text-lg transition" />
    </a>
  </div>
</header>
