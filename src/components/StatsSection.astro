---
import Icon from './Icon.astro';

const stats = [
  {
    id: 'speakers',
    target: 1.5,
    decimals: 1,
    suffix: 'B+',
    label: 'English speakers worldwide',
    note: '~19% of global population • 2026 data',
    icon: 'globe',
  },
  {
    id: 'market',
    target: 45,
    decimals: 0,
    suffix: 'B+',
    label: 'Projected Business English training market by 2033',
    note: 'Strong double-digit growth trajectory',
    icon: 'trending-up',
  },
  {
    id: 'hiring',
    target: 98.5,
    decimals: 1,
    suffix: '%',
    label: 'Employers assess English competency during hiring',
    note: 'Across 38 countries • Major competitive advantage',
    icon: 'user-check',
  },
];
---

<section id="stats" class="max-w-screen-xl mx-auto px-6 pb-16">
  <div class="max-w-3xl mb-10" data-reveal>
    <div class="uppercase tracking-[3px] text-xs font-semibold text-amber-500 mb-3">THE NUMBERS</div>
    <h2 class="section-header tracking-tighter">Why English-language brands are a category worth owning.</h2>
    <p class="mt-4 text-lg text-slate-400">
      The demand behind this domain is measured, not assumed — these are the market conditions any buyer
      would be building into.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {stats.map((stat) => (
      <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-7" data-reveal>
        <div class="flex items-start justify-between mb-6 gap-4">
          <div>
            <div
              class="metric text-white stat-number"
              data-target={stat.target}
              data-decimals={stat.decimals}
              data-suffix={stat.suffix}
            >
              {stat.target.toFixed(stat.decimals)}{stat.suffix}
            </div>
            <div class="text-sm font-medium text-slate-400 mt-1">{stat.label}</div>
          </div>
          <Icon name={stat.icon} class="text-4xl text-emerald-400/70 shrink-0" />
        </div>
        <div class="text-xs text-slate-400">{stat.note}</div>
      </div>
    ))}

    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-7" data-reveal>
      <div class="flex items-start justify-between mb-6 gap-4">
        <div>
          <div class="metric text-white">
            Up to <span class="stat-number" data-target="20" data-decimals="0" data-suffix="%">20%</span>
          </div>
          <div class="text-sm font-medium text-slate-400 mt-1">Higher earnings &amp; faster career progression</div>
        </div>
        <Icon name="rocket" class="text-4xl text-emerald-400/70 shrink-0" />
      </div>
      <div class="text-xs text-slate-400">For professionals with strong business English</div>
    </div>

    <div class="stat-card bg-slate-900 border border-slate-800 rounded-3xl p-7" data-reveal>
      <div class="flex items-start justify-between mb-6 gap-4">
        <div>
          <div class="text-[2.1rem] leading-none font-bold tracking-tighter">1 in 4</div>
          <div class="text-sm font-medium text-slate-400 mt-1">Employers have lost business due to language gaps</div>
        </div>
        <Icon name="users" class="text-4xl text-emerald-400/70 shrink-0" />
      </div>
      <div class="text-xs text-slate-400">Clear ROI on English fluency investments</div>
    </div>
  </div>

  <p class="text-center text-xs text-slate-400 mt-6">
    Sources: EF English Proficiency Index, industry market reports, employer surveys &amp; British Council data (2025–2026)
  </p>
</section>

<script>
  function animateCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.stat-number');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    counters.forEach((counter) => {
      const target = parseFloat(counter.dataset.target || '0');
      const decimals = parseInt(counter.dataset.decimals || '0', 10);
      const suffix = counter.dataset.suffix || '';
      const finalText = `${target.toFixed(decimals)}${suffix}`;

      if (reduced) {
        counter.textContent = finalText;
        return;
      }

      const duration = 1600;
      const startTime = performance.now();

      const update = (currentTime: number) => {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const value = target * eased;
        counter.textContent = `${value.toFixed(decimals)}${suffix}`;
        if (progress < 1) requestAnimationFrame(update);
        else counter.textContent = finalText;
      };

      requestAnimationFrame(update);
    });
  }

  const statsSection = document.getElementById('stats');
  if (statsSection && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounters();
            observer.disconnect();
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(statsSection);
  } else {
    animateCounters();
  }
</script>
