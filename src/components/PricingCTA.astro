---
import Icon from './Icon.astro';
import { PRICE, ACQUISITION_MAILTO } from '../config/site';

const included = [
  'Escrow.com protects both sides until the transfer clears',
  'Registrar push or auth code — usually the same day',
  'No hidden fees beyond the standard .com renewal',
];
---

<section class="bg-slate-900 border-y border-slate-800 py-16" data-reveal>
  <div class="max-w-screen-xl mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center">
      <div class="inline-block premium-badge px-5 py-1.5 rounded-3xl text-xs font-bold tracking-widest mb-6">
        PREMIUM ACQUISITION
      </div>

      <h2 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tighter mb-2">
        <span class="sr-only">Buy languageleapenglish.com — premium domain for sale at </span>{PRICE.formatted}
      </h2>
      <p class="text-lg sm:text-xl text-slate-300 mb-8">
        One-time acquisition • Full ownership • No ongoing fees
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-6">
        <button
          type="button"
          data-open-purchase
          data-cta="pricing-buy-now"
          class="flex-1 sm:flex-none inline-flex min-h-12 items-center justify-center gap-x-3 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 transition-all text-slate-950 font-semibold text-base sm:text-lg px-6 sm:px-10 py-4 rounded-3xl shadow-xl shadow-amber-500/30"
        >
          <Icon name="lock" class="text-lg" />
          <span>Buy Now — {PRICE.formatted} BIN</span>
        </button>

        <button
          type="button"
          data-open-contact
          data-cta="pricing-make-offer"
          class="flex-1 sm:flex-none inline-flex min-h-12 items-center justify-center gap-x-3 border border-slate-600 hover:bg-slate-800 active:bg-slate-950 transition-all font-semibold text-base sm:text-lg px-6 sm:px-8 py-4 rounded-3xl"
        >
          <span>Make an Offer</span>
        </button>

        <a
          href={ACQUISITION_MAILTO}
          data-cta="pricing-contact-agent"
          class="flex-1 sm:flex-none inline-flex min-h-12 items-center justify-center gap-x-3 text-slate-300 hover:text-white font-medium text-base px-6 py-4 rounded-3xl border border-transparent hover:border-slate-700 transition-all"
        >
          <Icon name="mail" class="text-lg" />
          <span>Contact the Owner</span>
        </a>
      </div>

      <ul class="flex flex-col sm:flex-row flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-slate-400 mb-6">
        {included.map((item) => (
          <li class="flex items-center justify-center gap-x-2">
            <span class="text-emerald-400"><Icon name="check" class="text-sm" /></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <div class="text-xs text-slate-400 max-w-md mx-auto">
        Installment schedules available for qualified buyers through Escrow.com.<br />
        Serious inquiries only — price reflects premium positioning in a high-growth category.
      </div>
    </div>
  </div>
</section>
