---
import Icon from './Icon.astro';
---

<section id="value" class="max-w-screen-xl mx-auto px-6 py-16">
  <div class="text-center mb-10">
    <div class="uppercase tracking-[3px] text-xs font-semibold text-amber-500 mb-2">IDEAL BUYERS &amp; USE CASES</div>
    <h2 class="section-header tracking-tighter">Built for serious players in the<br />English language ecosystem.</h2>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
    <div class="group bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all rounded-3xl p-6" data-reveal>
      <span class="text-amber-400 mb-5 block"><Icon name="graduation-cap" class="text-3xl" /></span>
      <h3 class="font-semibold mb-1.5">Online English Schools &amp; Platforms</h3>
      <p class="text-sm text-slate-400">Launch or rebrand your flagship English learning product with instant credibility.</p>
    </div>

    <div class="group bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all rounded-3xl p-6" data-reveal>
      <span class="text-amber-400 mb-5 block"><Icon name="briefcase" class="text-3xl" /></span>
      <h3 class="font-semibold mb-1.5">Business English &amp; Corporate Training</h3>
      <p class="text-sm text-slate-400">Target the massive corporate L&amp;D and executive coaching market.</p>
    </div>

    <div class="group bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all rounded-3xl p-6" data-reveal>
      <span class="text-amber-400 mb-5 block"><Icon name="robot" class="text-3xl" /></span>
      <h3 class="font-semibold mb-1.5">AI Language Tutors &amp; Apps</h3>
      <p class="text-sm text-slate-400">Perfect brand for next-gen conversational AI, speech practice, and adaptive learning tools.</p>
    </div>

    <div class="group bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all rounded-3xl p-6" data-reveal>
      <span class="text-amber-400 mb-5 block"><Icon name="plane" class="text-3xl" /></span>
      <h3 class="font-semibold mb-1.5">Immigration, Study Abroad &amp; Visa Prep</h3>
      <p class="text-sm text-slate-400">High-converting domain for IELTS, TOEFL, and professional English certification services.</p>
    </div>

    <div class="group bg-slate-900 hover:bg-slate-800 border border-slate-800 hover:border-slate-700 transition-all rounded-3xl p-6" data-reveal>
      <span class="text-amber-400 mb-5 block"><Icon name="newspaper" class="text-3xl" /></span>
      <h3 class="font-semibold mb-1.5">Content, Media &amp; Thought Leadership</h3>
      <p class="text-sm text-slate-400">Blog networks, YouTube channels, podcasts, or newsletters focused on English mastery.</p>
    </div>
  </div>
</section>
