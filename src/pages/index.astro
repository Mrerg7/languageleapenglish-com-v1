---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import OpportunitySection from '../components/OpportunitySection.astro';
import StatsSection from '../components/StatsSection.astro';
import WhySection from '../components/WhySection.astro';
import UseCases from '../components/UseCases.astro';
import PricingCTA from '../components/PricingCTA.astro';
import FAQSection from '../components/FAQSection.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import ExitIntent from '../components/ExitIntent.astro';
---

<BaseLayout>
  <Nav />
  <main id="main-content" class="pb-24 md:pb-0">
    <Hero />
    <TrustBar />
    <OpportunitySection />
    <StatsSection />
    <WhySection />
    <UseCases />
    <PricingCTA />
    <FAQSection />
    <ClosingCTA />
    <Footer />
  </main>
  <StickyMobileCTA />
  <ExitIntent />
</BaseLayout>

