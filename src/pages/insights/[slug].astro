---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import StickyMobileCTA from '../../components/StickyMobileCTA.astro';
import { SITE, PRICE, ACQUISITION_MAILTO, canonicalUrl } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const url = canonicalUrl(`/insights/${post.slug}/`);
const title = `${post.data.title} | ${SITE.brand} Domain Insights`;
const description = post.data.description;

const related = (await getCollection('blog'))
  .filter((entry) => entry.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);

const articleSchema = {
  '@type': 'Article',
  '@id': `${url}#article`,
  headline: post.data.title,
  description,
  url,
  datePublished: post.data.pubDate.toISOString().split('T')[0],
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString().split('T')[0],
  inLanguage: 'en-US',
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
  author: {
    '@type': 'Organization',
    name: SITE.brand,
    url: SITE.url,
  },
  publisher: {
    '@type': 'Organization',
    name: SITE.brand,
    url: SITE.url,
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  includeFaqSchema={false}
  extraSchema={[articleSchema]}
>
  <Nav />
  <main id="main-content" class="pb-24 md:pb-0">
    <article class="max-w-3xl mx-auto px-6 pt-12 pb-16">
      <nav aria-label="Breadcrumb" class="text-xs text-slate-400 mb-8">
        <ol class="flex flex-wrap items-center gap-x-2">
          <li><a href="/" class="hover:text-amber-400">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/insights/" class="hover:text-amber-400">Insights</a></li>
          <li aria-hidden="true">/</li>
          <li class="text-slate-300">{post.data.category}</li>
        </ol>
      </nav>

      <header class="mb-10">
        <div class="flex flex-wrap items-center gap-3 text-xs mb-5">
          <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 font-semibold tracking-wide">
            {post.data.category}
          </span>
          <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-slate-400">
            {post.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          {
            post.data.updatedDate && (
              <span class="text-slate-600">
                • Updated{' '}
                {post.data.updatedDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
            )
          }
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white leading-[1.1] mb-5">
          {post.data.title}
        </h1>
        <p class="text-lg text-slate-400 leading-relaxed">{post.data.description}</p>
      </header>

      <div class="prose-domain text-[17px]">
        <Content />
      </div>

      <div class="mt-12 rounded-3xl border border-amber-500/30 bg-slate-900 p-7 sm:p-9" data-reveal>
        <div class="uppercase tracking-[3px] text-xs font-semibold text-amber-500 mb-3">
          FEATURED DOMAIN
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-3">
          languageleapenglish.com — {PRICE.formatted}
        </h2>
        <p class="text-slate-400 text-[15px] leading-relaxed mb-6">
          Exact-match .com for English language learning, business English and global education
          brands. Escrow-protected transfer, typically completed within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <button
            type="button"
            data-open-purchase
            data-cta="article-buy-now"
            class="min-h-12 inline-flex items-center justify-center px-6 rounded-2xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold text-sm transition"
          >
            Buy at {PRICE.formatted}
          </button>
          <button
            type="button"
            data-open-contact
            data-cta="article-make-offer"
            class="min-h-12 inline-flex items-center justify-center px-6 rounded-2xl border border-slate-600 hover:bg-slate-800 font-semibold text-sm transition"
          >
            Make an Offer
          </button>
          <a
            href={ACQUISITION_MAILTO}
            data-cta="article-email"
            class="min-h-12 inline-flex items-center justify-center px-6 rounded-2xl text-slate-300 hover:text-white text-sm transition"
          >
            Email the owner
          </a>
        </div>
      </div>

      {
        related.length > 0 && (
          <section class="mt-14">
            <h2 class="text-xs uppercase tracking-[3px] text-slate-400 font-semibold mb-5">
              Related insights
            </h2>
            <div class="grid sm:grid-cols-2 gap-5">
              {related.map((entry) => (
                <a
                  href={`/insights/${entry.slug}/`}
                  class="group block bg-slate-900 border border-slate-800 hover:border-amber-500/50 rounded-2xl p-6 transition-all"
                >
                  <span class="block text-[11px] text-amber-400 font-semibold mb-2">
                    {entry.data.category}
                  </span>
                  <span class="block text-lg font-semibold text-white group-hover:text-amber-300 transition-colors mb-2">
                    {entry.data.title}
                  </span>
                  <span class="block text-sm text-slate-400 line-clamp-3">
                    {entry.data.description}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }
    </article>

    <Footer />
  </main>
  <StickyMobileCTA />
</BaseLayout>
