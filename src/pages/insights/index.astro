---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import StickyMobileCTA from '../../components/StickyMobileCTA.astro';
import { PRICE, ACQUISITION_MAILTO } from '../../config/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const title = 'Domain Insights | Premium Domain Valuation & Buying Guides';
const description =
  'Guides on premium domain valuation, English-learning domain investment and buying domains safely with escrow — from the owner of languageleapenglish.com.';
---

<BaseLayout title={title} description={description} includeFaqSchema={false}>
  <Nav />
  <main id="main-content" class="pb-24 md:pb-0">
    <header class="bg-slate-950 border-b border-slate-800">
      <div class="max-w-screen-xl mx-auto px-6 pt-16 pb-12">
        <nav aria-label="Breadcrumb" class="text-xs text-slate-400 mb-6">
          <ol class="flex flex-wrap items-center gap-x-2">
            <li><a href="/" class="hover:text-amber-400">Home</a></li>
            <li aria-hidden="true">/</li>
            <li class="text-slate-300">Insights</li>
          </ol>
        </nav>

        <div class="max-w-3xl">
          <div class="uppercase tracking-[3px] text-xs font-semibold text-amber-500 mb-3">
            DOMAIN INSIGHTS
          </div>
          <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-white mb-4">
            Premium domain valuation, market trends and safe buying guides
          </h1>
          <p class="text-lg text-slate-300 leading-relaxed">
            Practical, source-backed writing for buyers and owners navigating the premium domain
            aftermarket — including how
            <a href="/" class="text-amber-400 underline underline-offset-4 hover:text-amber-300"
              >languageleapenglish.com</a
            > was valued.
          </p>
        </div>
      </div>
    </header>

    <section class="max-w-screen-xl mx-auto px-6 py-14" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="sr-only">Latest domain insights</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
        {
          posts.map((post) => (
            <article
              class="group relative flex flex-col bg-slate-900 border border-slate-800 hover:border-amber-500/50 rounded-3xl p-7 transition-all hover:-translate-y-1"
              data-reveal
            >
              <div class="flex items-center gap-x-3 text-[11px] mb-4">
                <span class="px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 font-semibold tracking-wide">
                  {post.data.category}
                </span>
                <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-slate-400">
                  {post.data.pubDate.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'short',
                    day: 'numeric',
                  })}
                </time>
              </div>

              <h3 class="text-xl font-semibold text-white tracking-tight mb-3 group-hover:text-amber-300 transition-colors">
                <a href={`/insights/${post.slug}/`} class="after:absolute after:inset-0">
                  {post.data.title}
                </a>
              </h3>

              <p class="text-sm text-slate-400 leading-relaxed mb-5">{post.data.description}</p>

              <div class="mt-auto flex flex-wrap gap-2">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="text-[11px] px-2.5 py-1 rounded-lg bg-slate-950 border border-slate-800 text-slate-400">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bg-slate-900 border-y border-slate-800 py-14">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <div class="uppercase tracking-[3px] text-xs font-semibold text-amber-500 mb-3">
          FEATURED LISTING
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-white mb-4">
          languageleapenglish.com — {PRICE.formatted}
        </h2>
        <p class="text-slate-300 mb-7">
          An exact-match .com at the intersection of English language education and global business.
          Escrow-protected transfer, typically completed within 24 hours.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <button
            type="button"
            data-open-purchase
            data-cta="insights-buy-now"
            class="min-h-12 inline-flex items-center justify-center gap-x-2 px-7 rounded-3xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-semibold transition"
          >
            Buy this domain
          </button>
          <a
            href="/"
            data-cta="insights-home"
            class="min-h-12 inline-flex items-center justify-center px-7 rounded-3xl border border-slate-700 hover:bg-slate-800 font-medium transition"
          >
            View the full listing
          </a>
          <a
            href={ACQUISITION_MAILTO}
            data-cta="insights-email"
            class="min-h-12 inline-flex items-center justify-center px-7 rounded-3xl text-slate-300 hover:text-white underline underline-offset-8 decoration-slate-600 hover:decoration-amber-400 transition"
          >
            Email the owner
          </a>
        </div>
      </div>
    </section>

    <Footer />
  </main>
  <StickyMobileCTA />
</BaseLayout>
